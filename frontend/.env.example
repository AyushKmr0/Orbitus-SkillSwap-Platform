# ==========================================================
# Orbitus Frontend Environment Configuration
# ==========================================================

# 1. Local Machine Development (Default)
VITE_BACKEND_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
VITE_SOCKET_TRANSPORTS=polling,websocket

# 2. Local LAN / Mobile Device Testing
# NOTE: When accessing the frontend from a phone or other device on your local Wi-Fi,
# 'localhost' refers to the phone itself, NOT your development PC.
# Replace with your machine's local IP address (e.g., from `ipconfig` on Windows):
# VITE_BACKEND_URL=http://192.168.1.100:5000
# VITE_SOCKET_URL=http://192.168.1.100:5000
# Also ensure the backend has ALLOW_LOCAL_ORIGINS=true or FRONTEND_URLS includes your LAN URL.

# 3. Production Deployment (e.g., Vercel -> Render)
# VITE_BACKEND_URL=https://orbitus-skill-swap-platform.onrender.com
# VITE_SOCKET_URL=https://orbitus-skill-swap-platform.onrender.com
# If backend is horizontally scaled across multiple replicas without sticky session affinity:
# VITE_SOCKET_TRANSPORTS=websocket
