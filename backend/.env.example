# Server Configuration
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/orbitus

# Redis Connection (Optional for local dev, Required for production scaling)
REDIS_URL=redis://127.0.0.1:6379

# Authentication & JWT Secrets (REQUIRED in production)
JWT_SECRET=your_production_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Key for sensitive fields (REQUIRED in production)
ENCRYPTION_KEY=your_32_byte_production_encryption_key_placeholder

# Optional Admin Key override (role-based admin accounts preferred)
ADMIN_SECRET_KEY=your_admin_secret_key_placeholder

# Email / SMTP Service (Optional in dev)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Orbitus Platform <noreply@orbitus.com>

# Cloudinary Storage Configuration (Optional in dev)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Feature Keys (Optional)
GEMINI_API_KEY=your_gemini_api_key